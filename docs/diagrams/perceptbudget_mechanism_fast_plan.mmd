    classDef choice fill:#fff6dd,stroke:#b88c2b,color:#574213,stroke-width:1.5px;
    classDef planned fill:#f3edff,stroke:#8053ad,color:#4a2c66,stroke-width:2px,stroke-dasharray:6 4;
    classDef compute fill:#e6f6f0,stroke:#35836c,color:#214f41,stroke-width:1.5px;
    class S,B,C,E,P,D,H,A,L current;
    class T,R,I,K,Q choice;
    class F planned;
    class N compute;
